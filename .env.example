# Environment for local development. Copy to `.env` and never commit the result.
# The server reads only the variables it needs; nothing here has a default secret.

# Required. Authorizes POST /v1/tenants (office creation). Use a long random value:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
HOSHYAR_BOOTSTRAP_KEY=

# Optional. SQLite file the server persists state to. Defaults to ./hoshyar.sqlite3.
HOSHYAR_DATABASE_PATH=hoshyar.sqlite3

# Optional. Interface and port the HTTP server binds to. Defaults to 127.0.0.1:8000.
HOSHYAR_HOST=127.0.0.1
HOSHYAR_PORT=8000

# Optional. One of debug, info, warning, error. Defaults to info.
HOSHYAR_LOG_LEVEL=info
